{
  "name": "@cdr-kit/agent",
  "version": "0.5.0",
  "description": "Autonomous agent client for Story CDR: discover -> subscribe -> access vaults from its own wallet.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/agent-demo.ts"
  },
  "dependencies": {
    "@cdr-kit/contracts": "workspace:*",
    "@cdr-kit/core": "workspace:*",
    "pino": "^9.5.0"
  },
  "peerDependencies": {
    "@cdr-kit/story": ">=0.4.0",
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "@cdr-kit/story": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cdr-kit/story": "workspace:*",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
