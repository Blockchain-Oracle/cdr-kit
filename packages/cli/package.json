{
  "name": "@cdr-kit/cli",
  "version": "0.4.1",
  "description": "The cdr CLI + MCP server factory + auto-wallet + Claude Code skill installer. One binary, three surfaces (CLI / MCP / skill).",
  "type": "module",
  "bin": {
    "cdr": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.mts",
        "default": "./dist/lib.mjs"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.mjs",
  "types": "./dist/lib.d.mts",
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-plugin.mjs",
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cdr-kit/agent": "workspace:*",
    "@cdr-kit/contracts": "workspace:*",
    "@cdr-kit/core": "workspace:*",
    "@cdr-kit/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "open": "^10.1.0",
    "pino": "^9.5.0"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
