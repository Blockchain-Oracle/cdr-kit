{
  "name": "@cdr-kit/mcp",
  "version": "0.5.2",
  "description": "Stdio MCP server for Story CDR — wrapper around @cdr-kit/cli so `npx @cdr-kit/mcp` Just Works in any MCP host.",
  "type": "module",
  "bin": {
    "cdr-kit-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@cdr-kit/agent": "workspace:*",
    "@cdr-kit/cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3"
  },
  "engines": {
    "node": ">=20"
  }
}
