{
  "name": "@cdr-kit/forms",
  "version": "0.7.2",
  "description": "Encrypted form submission components for CDR — multi-provider storage, platform wallet, whole-form encryption.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src/styles.css",
    "src/assets"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@cdr-kit/core": ">=0.6.0",
    "@cdr-kit/react": ">=0.6.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@cdr-kit/core": {
      "optional": true
    }
  },
  "dependencies": {
    "consola": "^3.2.3"
  },
  "devDependencies": {
    "@cdr-kit/agent": "workspace:*",
    "@cdr-kit/contracts": "workspace:*",
    "@cdr-kit/core": "workspace:*",
    "@cdr-kit/react": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "happy-dom": "^15.11.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
