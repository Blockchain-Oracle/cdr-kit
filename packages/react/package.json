{
  "name": "@cdr-kit/react",
  "version": "0.0.0",
  "description": "React provider, <VaultGate>, and hooks for Story CDR — built on @cdr-kit/core.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cdr-kit/contracts": "workspace:*",
    "@cdr-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "viem": "^2",
    "wagmi": ">=2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "wagmi": "^2.14.0"
  }
}
