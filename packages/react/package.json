{
  "name": "@cdr-kit/react",
  "version": "0.5.0",
  "description": "React provider, <VaultGate>, and hooks for Story CDR — built on @cdr-kit/core.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cdr-kit/contracts": "workspace:*",
    "@cdr-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "@cdr-kit/agent": ">=0.4.0",
    "@cdr-kit/story": ">=0.4.0",
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "viem": "^2",
    "wagmi": ">=2"
  },
  "peerDependenciesMeta": {
    "@cdr-kit/agent": {
      "optional": true
    },
    "@cdr-kit/story": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cdr-kit/agent": "workspace:*",
    "@cdr-kit/story": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^15.11.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "vitest": "^2.1.8",
    "wagmi": "^2.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
