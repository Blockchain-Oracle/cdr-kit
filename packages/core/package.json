{
  "name": "@cdr-kit/core",
  "version": "0.4.0",
  "description": "Typed TS SDK for Story CDR: condition encoders, the CdrKitVault flow, and the 2-step pay->access helpers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "tsx scripts/e2e-roundtrip.ts",
    "e2e:file": "tsx scripts/e2e-file.ts",
    "seed": "tsx scripts/seed-vaults.ts"
  },
  "dependencies": {
    "@cdr-kit/contracts": "workspace:*",
    "@piplabs/cdr-crypto": "^0.2.1",
    "@piplabs/cdr-sdk": "^0.2.1",
    "multiformats": "^13.3.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true },
    "@storacha/client": { "optional": true },
    "helia": { "optional": true },
    "@helia/unixfs": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@helia/unixfs": "^5.0.0",
    "consola": "^3.2.3",
    "helia": "^5.5.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.51.3"
  },
  "engines": {
    "node": ">=20"
  }
}
