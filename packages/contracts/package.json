{
  "name": "@cdr-kit/contracts",
  "version": "0.7.2",
  "description": "Typed ABIs + verified addresses for cdr-kit contracts and Story CDR.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "wagmi": "wagmi generate",
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@wagmi/cli": "^2.10.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3"
  },
  "engines": {
    "node": ">=20"
  }
}
