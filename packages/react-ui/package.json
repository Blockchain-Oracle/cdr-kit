{
  "name": "@cdr-kit/react-ui",
  "version": "0.7.3",
  "description": "Styled component variants for @cdr-kit/react — ConditionBadge, AccessStepper, SubscribeButton, VaultCard + DX primitives. CSS-variable themed; no Tailwind, no lucide, no framer-motion hard deps.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@cdr-kit/react": ">=0.4.0",
    "@cdr-kit/core": ">=0.4.0",
    "@radix-ui/react-popover": ">=1.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@cdr-kit/core": "workspace:*",
    "@cdr-kit/react": "workspace:*",
    "@radix-ui/react-popover": "^1.1.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.51.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
